# Copy to .env.local and fill in. Never commit real keys.

# Server-only key for the AI chat assistant (https://console.groq.com/keys)
GROQ_API_KEY=

# Admin at /admin. The login stays disabled until both are set.
# Password: 12+ characters. Secret: 32+ random characters, e.g. from
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Vercel Blob store for uploads from /admin. Connecting a public Blob store to
# the Vercel project adds this; pull it locally with `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN=
